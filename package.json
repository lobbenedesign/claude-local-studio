{
  "name": "claude-local-studio",
  "version": "1.0.0",
  "description": "Claude Code Local Studio - Unlimited Free Tokens with Local Ollama & HuggingFace Models",
  "type": "module",
  "scripts": {
    "dev": "bun --watch server.ts",
